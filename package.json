{
  "name": "youtube-multitasker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build-side-panel && npm run build-background",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-side-panel": "tsc -b && vite build --config .config/sidePanel.config.ts",
    "build-background": "tsc -b && vite build --config .config/background.config.ts"
  },
  "dependencies": {
    "@types/chrome": "^0.0.278",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
